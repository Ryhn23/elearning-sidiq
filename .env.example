# ============================================================
# E-Learning — environment untuk docker-compose (root proyek)
# Salin menjadi `.env` lalu isi:  cp .env.example .env
# File `.env` TIDAK boleh di-commit ke git.
# ============================================================

# --- JWT (WAJIB di produksi) ---
# Buat secret acak:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- URL publik frontend (untuk tautan email, redirect OAuth, CORS) ---
# Default http://localhost:8080 sudah sesuai compose; ubah jika deploy ke domain lain.
APP_URL=http://localhost:8080
