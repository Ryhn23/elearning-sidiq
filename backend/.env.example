# ============================================================
# E-Learning Backend — contoh environment variables
# Salin menjadi `.env` lalu sesuaikan. Semua variabel opsional
# kecuali DATABASE_URL (ada fallback default untuk dev).
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://user:password@localhost:5432/elearning

# --- Server ---
PORT=3000

# --- JWT (WAJIB, min. 32 karakter acak — server menolak start jika kurang) ---
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- URL publik (untuk tautan di email & redirect OAuth) ---
# URL frontend yang bisa diakses user (dev: vite, docker: nginx)
APP_URL=http://localhost:5174
# URL publik untuk tautan verifikasi sertifikat (biasanya sama dengan APP_URL)
PUBLIC_URL=http://localhost:5174

# --- Email (SMTP) ---
# Jika SMTP_HOST tidak diset → email hanya di-log ke console (dry-run, aman untuk dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@elearning.local

# --- Google OAuth (opsional — fitur "Login/Bind dengan Google") ---
# Ambil dari https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI harus terdaftar di Google Cloud Console:
#   Bind:  ${APP_URL}/api/v1/auth/me/google/callback
#   Login: ${APP_URL}/api/v1/auth/google/callback
# Override hanya jika APP_URL berbeda dari yang terdaftar:
GOOGLE_REDIRECT_BIND_URL=
GOOGLE_REDIRECT_LOGIN_URL=

# --- Redis (opsional) ---
# Jika tidak diset → rate limiter memakai memori in-process (cukup untuk 1 instance)
REDIS_URL=
